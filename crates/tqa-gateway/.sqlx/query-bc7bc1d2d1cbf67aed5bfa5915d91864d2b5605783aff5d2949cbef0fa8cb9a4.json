  "query": "SELECT w.id AS workspace, w.lease_conversation_id AS \"holder!\", COALESCE(w.lease_expires_at<=CURRENT_TIMESTAMP, true) AS \"expired!\", COALESCE(h.pinned, false) AS \"pinned!\" FROM workspaces w LEFT JOIN conversations h ON h.id=w.lease_conversation_id WHERE w.id = ANY($1) AND w.lease_conversation_id IS NOT NULL AND EXISTS(SELECT 1 FROM sandbox_instances s WHERE s.conversation_id=w.lease_conversation_id)",
