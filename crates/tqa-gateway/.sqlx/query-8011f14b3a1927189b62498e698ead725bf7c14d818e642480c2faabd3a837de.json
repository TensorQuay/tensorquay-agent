{
  "db_name": "PostgreSQL",
  "query": "SELECT c.id, c.owner_id, c.name, c.purpose, c.rule, c.state, c.last_seq, c.created_at, c.ended_at, o.email::text AS \"owner_name!\", (SELECT count(*) FROM channel_members m WHERE m.channel_id = c.id) AS \"member_count!\", (SELECT m.role FROM channel_members m WHERE m.channel_id = c.id AND m.user_id = $1) AS role FROM channels c JOIN users o ON o.id = c.owner_id WHERE c.kind = 'channel' AND ($3::uuid IS NULL OR c.id = $3) AND ($2 OR c.owner_id = $1 OR EXISTS (SELECT 1 FROM channel_members m WHERE m.channel_id = c.id AND m.user_id = $1) OR EXISTS (SELECT 1 FROM channel_members m JOIN conversations v ON v.id = m.conversation_id WHERE m.channel_id = c.id AND v.owner_id = $1)) ORDER BY COALESCE((SELECT max(x.created_at) FROM channel_messages x WHERE x.channel_id = c.id), c.created_at) DESC, c.id DESC LIMIT $4",
