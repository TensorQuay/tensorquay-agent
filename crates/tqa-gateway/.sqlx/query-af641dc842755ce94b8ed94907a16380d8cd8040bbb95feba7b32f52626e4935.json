  "query": "SELECT EXISTS (SELECT 1 FROM idempotency WHERE conversation_id = $2 AND execution_status = 'queued' AND key LIKE $3) AS \"waking!\", cv.runtime_revision, ch.budget, ch.spent_tokens, ch.wakes_bounded, EXISTS (SELECT 1 FROM channel_messages x JOIN channel_members m ON m.channel_id = x.channel_id AND m.conversation_id = $2 WHERE x.channel_id = $1 AND x.seq > m.read_seq AND $2 = ANY(x.wakes)) AS \"unread!\", EXISTS (SELECT 1 FROM channel_unreachable u WHERE u.channel_id = $1 AND u.conversation_id = $2 AND u.reason = 'runtime') AS \"unreachable!\" FROM channels ch, conversations cv WHERE ch.id = $1 AND cv.id = $2",
