  "query": "SELECT id, email::text AS \"email!\", role, CASE WHEN accepted_at IS NOT NULL THEN 'accepted' WHEN revoked_at IS NOT NULL THEN 'revoked' WHEN expires_at<=CURRENT_TIMESTAMP THEN 'expired' ELSE 'pending' END AS \"status!\", created_by, created_at, expires_at FROM invitations ORDER BY created_at DESC, id DESC LIMIT $1",
