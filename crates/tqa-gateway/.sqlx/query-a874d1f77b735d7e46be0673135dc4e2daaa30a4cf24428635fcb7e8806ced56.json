  "query": "SELECT m.author_id, m.author_name, m.body, EXISTS (SELECT 1 FROM agent_team_members a JOIN conversations c ON c.id = a.conversation_id WHERE a.team_id = $3 AND a.conversation_id::text = m.author_id AND c.state <> 'deleted') AS \"present!\" FROM channel_messages m WHERE m.channel_id = $1 AND m.seq = $2 AND m.type = 'report'",
