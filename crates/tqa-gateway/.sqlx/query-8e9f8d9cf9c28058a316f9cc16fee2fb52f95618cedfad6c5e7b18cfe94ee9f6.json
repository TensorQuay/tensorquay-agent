  "query": "SELECT m.conversation_id AS task, t.id, t.state, t.lead_conversation, c.title AS \"title?\", m.name, m.state AS helper_state, m.failed_run FROM agent_team_members m JOIN agent_teams t ON t.id = m.team_id JOIN conversations c ON c.id = t.lead_conversation WHERE m.conversation_id = ANY($1) AND c.state <> 'deleted'",
