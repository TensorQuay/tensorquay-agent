{
  "db_name": "PostgreSQL",
  "query": "SELECT x.seq, x.type AS kind, p.author_id AS \"parent_author?\", x.author_kind, x.parent, x.body->>'text' AS words FROM channel_messages x LEFT JOIN channel_messages p ON p.channel_id = x.channel_id AND p.seq = x.parent WHERE x.channel_id = $1 AND x.seq > $2 AND $3 = ANY(x.wakes) ORDER BY x.seq",
