  "query": "SELECT w.id, w.owner_id, w.name, w.state, s.access AS \"access?\", w.created_at, w.updated_at, w.last_used_at, w.size_bytes, w.size_measured_at, w.forked_from, w.fork_consistent, w.kind, w.quota_bytes, o.email::text AS \"owner_email!\", (SELECT count(*) FROM workspace_shares x WHERE x.workspace_id=w.id) AS \"share_count!\", (SELECT count(*) FROM conversations c WHERE c.workspace_id=w.id AND c.state='active') AS \"task_count!\" FROM workspaces w JOIN users o ON o.id=w.owner_id LEFT JOIN workspace_shares s ON s.workspace_id=w.id AND s.user_id=$2 WHERE w.id=$1 AND w.state<>'deleted'",
