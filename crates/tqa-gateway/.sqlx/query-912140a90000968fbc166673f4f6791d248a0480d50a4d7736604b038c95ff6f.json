{
  "db_name": "PostgreSQL",
  "query": "SELECT f.seq, f.index, f.name, ch.name AS channel_name FROM channel_files f JOIN channels ch ON ch.id = f.channel_id WHERE f.channel_id = $1 AND f.seq > $2 AND ($3::bigint IS NULL OR f.seq <= $3) AND NOT EXISTS (SELECT 1 FROM channel_file_placements p WHERE p.channel_id = f.channel_id AND p.seq = f.seq AND p.index = f.index AND p.conversation_id = $4) ORDER BY f.seq, f.index",
