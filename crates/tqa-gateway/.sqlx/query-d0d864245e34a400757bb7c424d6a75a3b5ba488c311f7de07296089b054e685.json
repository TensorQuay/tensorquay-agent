  "query": "SELECT m.conversation_id, m.name, t.channel_id, m.created_at < CURRENT_TIMESTAMP - make_interval(mins => $1) AS \"overdue!\" FROM agent_team_members m JOIN agent_teams t ON t.id = m.team_id WHERE m.state = 'starting' AND NOT EXISTS (SELECT 1 FROM idempotency i WHERE i.conversation_id = m.conversation_id AND i.key = 'team-start:' || m.conversation_id::text)",
