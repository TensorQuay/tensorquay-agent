  "query": "SELECT t.sandbox_id AS \"sandbox!\", t.created_at, c.owner_id FROM runtime_tokens t JOIN conversations c ON c.id=t.conversation_id WHERE t.conversation_id=$1 AND t.sandbox_id IS NOT NULL AND EXISTS (SELECT 1 FROM host_key_placeholders p WHERE p.conversation_id=$1 AND p.sandbox_id=t.sandbox_id AND p.run_id IS NOT NULL AND p.ended_at IS NULL AND p.host=$2 AND p.port=$3)",
