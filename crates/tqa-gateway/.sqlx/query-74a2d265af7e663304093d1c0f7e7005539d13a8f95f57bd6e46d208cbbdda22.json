{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT ON (r.ref) r.ref, r.last_at, r.count, r.outcome, r.conversation_id, r.user_id, u.email AS \"email?\", c.title AS \"title?\", c.owner_id AS \"conversation_owner?\" FROM secret_reads r LEFT JOIN users u ON u.id=r.user_id LEFT JOIN conversations c ON c.id=r.conversation_id WHERE r.consumer_kind='host' AND r.ref=ANY($1) AND ($2::uuid IS NULL OR r.user_id=$2) ORDER BY r.ref, r.last_at DESC, r.id DESC",
