  "db_name": "PostgreSQL",
  "query": "SELECT id, owner_id, name, host, port, path_prefix, scheme, user_name, header_name, secret_ref, check_name, set_at, version FROM host_keys k WHERE owner_id IS NULL AND (for_everyone OR EXISTS (SELECT 1 FROM host_key_users u WHERE u.key_id=k.id AND u.user_id=$1)) ORDER BY name LIMIT $2",
