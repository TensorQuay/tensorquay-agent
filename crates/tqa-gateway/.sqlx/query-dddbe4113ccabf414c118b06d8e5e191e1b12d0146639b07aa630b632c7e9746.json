{
  "db_name": "PostgreSQL",
  "query": "SELECT m.conversation_id, m.name, m.role, m.workspace, m.state, m.failed_run, (SELECT COALESCE(sum(COALESCE(u.prompt_tokens, 0) + COALESCE(u.completion_tokens, 0)), 0) FROM usage u WHERE u.conversation_id = m.conversation_id AND u.created_at >= $2)::bigint AS \"tokens!\", EXISTS (SELECT 1 FROM usage u WHERE u.conversation_id = m.conversation_id AND u.created_at >= $2 AND u.estimated) AS \"tokens_estimated!\" FROM agent_team_members m JOIN conversations c ON c.id = m.conversation_id WHERE m.team_id = $1 AND c.state <> 'deleted' ORDER BY m.created_at",
