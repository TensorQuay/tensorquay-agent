{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.run_id, r.user_id, k.name, (k.owner_id IS NOT DISTINCT FROM $4 OR (k.owner_id IS NULL AND (k.for_everyone OR EXISTS (SELECT 1 FROM host_key_users u WHERE u.key_id=k.id AND u.user_id=$4)))) AS \"usable!\", r.consumer, r.outcome, r.count, r.first_at, r.last_at FROM secret_reads r JOIN host_keys k ON k.secret_ref=r.ref WHERE r.consumer_kind='host' AND r.conversation_id=$1 AND ($2::uuid IS NULL OR (r.last_at, r.id) < (SELECT last_at, id FROM secret_reads WHERE id=$2)) ORDER BY r.last_at DESC, r.id DESC LIMIT $3",
