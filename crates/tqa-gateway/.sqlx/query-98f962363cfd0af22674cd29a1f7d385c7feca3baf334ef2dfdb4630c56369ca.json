  "query": "UPDATE agent_teams t SET spent_tokens = t.spent_tokens + $2 WHERE t.state <> 'ended' AND (t.lead_conversation = $1 OR EXISTS (SELECT 1 FROM agent_team_members m WHERE m.team_id = t.id AND m.conversation_id = $1)) RETURNING t.id, t.channel_id, t.state, t.spent_tokens, t.token_budget",
