  "db_name": "PostgreSQL",
  "query": "SELECT t.state, t.stop_reason, t.spent_tokens >= t.token_budget AS \"spent!\", t.spent_tokens * 100 >= t.token_budget * $2 AS \"helpers_out!\", t.deadline_at <= CURRENT_TIMESTAMP AS \"late!\", t.lead_conversation = $1 AS \"lead!\" FROM agent_teams t WHERE t.state <> 'ended' AND (t.lead_conversation = $1 OR EXISTS (SELECT 1 FROM agent_team_members m WHERE m.team_id = t.id AND m.conversation_id = $1))",
