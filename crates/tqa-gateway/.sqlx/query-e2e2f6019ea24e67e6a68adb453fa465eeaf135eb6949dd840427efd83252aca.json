{
  "db_name": "PostgreSQL",
  "query": "SELECT s.conversation_id, s.phase, s.created_at, s.last_action_at, s.idle_seconds, s.max_lifetime_seconds, s.cpu_millicores, s.memory_bytes, s.pids, c.owner_id, u.email::text AS \"email!\", c.template, COALESCE(t.display_name, c.template) AS \"display_name!\", COALESCE('desktop'=ANY(t.capabilities), false) AS \"desktop!\", c.pinned, c.keep_sign_in, COALESCE((SELECT e.lifecycle FROM events e WHERE e.conversation_id=s.conversation_id AND e.lifecycle IS NOT NULL ORDER BY e.seq DESC LIMIT 1) IN ('run.started','run.resumed'), false) AS \"working!\", EXISTS (SELECT 1 FROM idempotency i WHERE i.conversation_id=s.conversation_id AND i.execution_status IN ('queued','sending')) AS \"work_waiting!\" FROM sandbox_instances s JOIN conversations c ON c.id=s.conversation_id JOIN users u ON u.id=c.owner_id LEFT JOIN templates t ON t.name=c.template ORDER BY s.created_at, s.conversation_id LIMIT $1",
