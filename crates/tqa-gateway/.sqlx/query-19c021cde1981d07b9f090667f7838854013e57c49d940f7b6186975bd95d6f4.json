  "query": "SELECT id,consumer_kind,consumer,conversation_id,user_id,run_id,outcome,count,first_at,last_at FROM secret_reads WHERE ref=$1 AND ($2::uuid IS NULL OR (last_at,id) < (SELECT last_at,id FROM secret_reads WHERE id=$2)) AND ($4::uuid IS NULL OR user_id=$4) ORDER BY last_at DESC, id DESC LIMIT $3",
