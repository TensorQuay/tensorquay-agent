{
  "db_name": "PostgreSQL",
  "query": "SELECT p.type, p.body, p.created_at, c.rule, (SELECT d.seq FROM channel_messages d WHERE d.channel_id = p.channel_id AND d.type = 'decision' AND d.proposal_seq = p.seq ORDER BY d.seq LIMIT 1) AS decision_seq, (SELECT d.body->>'outcome' FROM channel_messages d WHERE d.channel_id = p.channel_id AND d.type = 'decision' AND d.proposal_seq = p.seq ORDER BY d.seq LIMIT 1) AS decision_outcome FROM channel_messages p JOIN channels c ON c.id = p.channel_id WHERE p.channel_id = $1 AND p.seq = $2",
