  "query": "SELECT i.ordinal AS \"ordinal!\", i.user_id, u.email::text AS \"email!\", i.created_at, i.updated_at, i.execution_status, i.execution_error, i.queued_frame, i.held FROM idempotency i JOIN users u ON u.id=i.user_id WHERE i.conversation_id=$1 AND i.route=$2 AND (i.held OR i.execution_status='queued' OR (i.execution_status='failed' AND i.execution_error IN ('sandbox_failed','runtime_start_failed','decision_engine_unavailable'))) AND i.execution_status<>'cancelled' ORDER BY i.ordinal LIMIT $3",
