{
  "db_name": "PostgreSQL",
  "query": "SELECT CASE WHEN usable THEN p.key_id END AS \"key_id?\", k.secret_ref AS \"secret_ref?\", p.conversation_id, p.sandbox_id, p.run_id, p.ended_at IS NOT NULL AS \"ended!\", p.sender_id, p.name, COALESCE(k.host, p.host) AS \"host!\", COALESCE(k.port, p.port) AS \"port!\", CASE WHEN k.id IS NULL THEN p.path_prefix ELSE k.path_prefix END AS path_prefix, COALESCE(k.scheme, p.scheme) AS \"scheme!\", CASE WHEN k.id IS NULL THEN p.user_name ELSE k.user_name END AS user_name FROM host_key_placeholders p LEFT JOIN host_keys k ON k.id=p.key_id CROSS JOIN LATERAL (SELECT k.id IS NOT NULL AND (k.owner_id=p.sender_id OR (k.owner_id IS NULL AND (k.for_everyone OR EXISTS (SELECT 1 FROM host_key_users u WHERE u.key_id=k.id AND u.user_id=p.sender_id))))AS usable) m WHERE p.hash=$1",
