  "query": "SELECT seq, author_kind, author_id, author_name, parent, body, created_at FROM channel_messages WHERE channel_id = $1 AND seq > $2 AND (cardinality($3::text[]) = 0 OR type = ANY($3)) AND ($4::bigint IS NULL OR parent = $4) AND ($5::bigint IS NULL OR task_seq = $5 OR (seq = $5 AND type = 'task')) AND ($6::text IS NULL OR author_kind = $6) ORDER BY seq LIMIT $7",
