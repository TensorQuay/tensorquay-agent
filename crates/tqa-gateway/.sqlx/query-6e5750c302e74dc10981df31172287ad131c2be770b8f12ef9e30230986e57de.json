  "query": "SELECT q.seq, q.body->>'text' AS \"text!\", q.created_at FROM channel_messages q WHERE q.channel_id = $1 AND q.type = 'person_question' AND NOT EXISTS (SELECT 1 FROM channel_messages a WHERE a.channel_id = q.channel_id AND a.type = 'person_answer' AND a.body->>'question_seq' = q.seq::text) ORDER BY q.seq DESC LIMIT 1",
