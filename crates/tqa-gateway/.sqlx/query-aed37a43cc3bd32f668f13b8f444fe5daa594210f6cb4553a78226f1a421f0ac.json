{
  "db_name": "PostgreSQL",
  "query": "SELECT m.channel_id AS \"channel!\", m.conversation_id AS \"conversation!\", m.read_seq, cv.owner_id, cv.runtime_revision, COALESCE(m.name, cv.profile->>'display_name', cv.profile->>'name', 'An agent') AS \"title!\", ch.budget, ch.spent_tokens, (SELECT min(x.hop) FROM channel_messages x WHERE x.channel_id = m.channel_id AND x.seq > m.read_seq AND m.conversation_id = ANY(x.wakes)) AS \"hop!\", (SELECT CASE WHEN e.lifecycle = 'run.failed' THEN e.seq END FROM events e WHERE e.conversation_id = m.conversation_id AND e.lifecycle IS NOT NULL ORDER BY e.seq DESC LIMIT 1) AS failed FROM channel_members m JOIN channels ch ON ch.id = m.channel_id JOIN conversations cv ON cv.id = m.conversation_id WHERE ch.kind = 'channel' AND ch.state = 'open' AND m.role <> 'observer' AND cv.state = 'active' AND ($1::uuid IS NULL OR m.channel_id = $1) AND EXISTS (SELECT 1 FROM channel_messages x WHERE x.channel_id = m.channel_id AND x.seq > m.read_seq AND m.conversation_id = ANY(x.wakes)) ORDER BY m.channel_id, m.conversation_id",
