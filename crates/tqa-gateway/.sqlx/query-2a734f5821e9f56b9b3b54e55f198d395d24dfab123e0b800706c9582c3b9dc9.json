  "query": "SELECT id, name, host, port, path_prefix, scheme, user_name, owner_id IS NULL AS \"shared!\" FROM host_keys k WHERE scheme IN ('bearer', 'basic') AND (owner_id=$1 OR (owner_id IS NULL AND (for_everyone OR EXISTS (SELECT 1 FROM host_key_users u WHERE u.key_id=k.id AND u.user_id=$1)))) ORDER BY name, id",
