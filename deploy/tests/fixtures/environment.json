        {
          "type": "tool_call",
          "name": "write_file",
          "arguments": {
            "path": "environment/index.html",
            "content": "<!doctype html><html lang=\"en\"><meta charset=\"utf-8\"><title>Environment check</title><body><h1>Workspace survived</h1><p>This page was rendered after the environment switch.</p></body></html>\n",
            "create_parents": false
          },
          "split_into": 3
        },
        {
          "type": "tool_call",
          "name": "write_file",
          "arguments": {
            "path": "environment/browser.cjs",
            "content": "const { chromium } = require('playwright');\nasync function main() {\n  const browser = await chromium.launch({ executablePath: '/usr/bin/chromium', chromiumSandbox: false, headless: true });\n  try {\n    const page = await browser.newPage({ viewport: { width: 800, height: 600 } });\n    await page.goto('file:///workspace/environment/index.html');\n    if (await page.locator('h1').textContent() !== 'Workspace survived') throw new Error('Unexpected page');\n    await page.screenshot({ path: 'environment/page.png' });\n    console.log('Saved environment/page.png');\n  } finally {\n    await browser.close();\n  }\n}\nmain().catch(error => { console.error(error); process.exitCode = 1; });\n",
            "create_parents": false
          },
          "split_into": 4
        }
      ],
      "usage": {
        "prompt_tokens": 120,
        "completion_tokens": 100
      }
    },
    {
      "when": "Create a small test file",
      "events": [
        {
          "type": "tool_call",
          "name": "shell",
          "arguments": {
